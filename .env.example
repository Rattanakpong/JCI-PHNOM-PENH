# --- Database ---
# Supabase Postgres — Dashboard → Connect. Pooled (6543) for the app,
# session/direct (5432) for migrations.
DATABASE_URL="postgresql://postgres.xxxxxxxx:password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:password@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- Local admin auth (used while Supabase isn't configured) ---
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Supabase (production auth + storage; optional in local dev) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="service-role-key" # server-only, never expose to the client

# --- File storage (admin-uploaded photos, PDFs) ---
# Priority order in src/lib/storage.ts: Cloudflare R2 (if R2_* vars are set)
# → Supabase Storage (if SUPABASE_SERVICE_ROLE_KEY is set) → local disk under
# /public/uploads. R2 is free (10GB storage, zero egress fees) — create a
# bucket + an Account API Token (Object Read & Write, scoped to that bucket)
# at dash.cloudflare.com, then enable the bucket's Public Development URL
# (or a custom domain for production) for R2_PUBLIC_URL.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="jci-media"
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="jci-media"

# --- ABA PAY / KHQR ---
ABA_MERCHANT_NAME="JCI Phnom Penh"
ABA_MERCHANT_CITY="Phnom Penh"
ABA_ACCOUNT_ID="your_aba_deeplink_account_id"
ABA_MERCHANT_ID="your_aba_merchant_id" # used for dynamic QR + check-transaction API
ABA_API_BASE_URL="https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1"
ABA_API_KEY=""

# --- Outgoing email (Gmail SMTP, via an App Password) ---
# Used to email admin setup/password-reset links (src/lib/email.ts). Generate
# the app password at myaccount.google.com/apppasswords — requires 2-Step
# Verification on the sending account. Free under Gmail's normal sending limits.
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="16-char-app-password"
EMAIL_FROM_NAME="JCI Phnom Penh"

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
