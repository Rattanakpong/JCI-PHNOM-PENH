# --- Database ---
# Local dev: SQLite, zero setup.
DATABASE_URL="file:./dev.db"
# Production: point at Supabase Postgres instead (also flip prisma/schema.prisma's
# datasource provider to "postgresql" — see README "Switching to Postgres/Supabase").
# DATABASE_URL="postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres"

# --- Local admin auth (used while Supabase isn't configured) ---
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Supabase (production auth + storage; optional in local dev) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="service-role-key" # server-only, never expose to the client

# --- Storage (payment receipts, media kit, project photos) ---
# Local dev saves uploads to /public/uploads instead; set these for production.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="jci-media"
# or, if using Cloudinary instead of Supabase Storage:
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- ABA PAY / KHQR ---
ABA_MERCHANT_NAME="JCI Phnom Penh"
ABA_MERCHANT_CITY="Phnom Penh"
ABA_ACCOUNT_ID="your_aba_deeplink_account_id"
ABA_MERCHANT_ID="your_aba_merchant_id" # used for dynamic QR + check-transaction API
ABA_API_BASE_URL="https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1"
ABA_API_KEY=""

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
